# The public origin the app is served from. A loopback URL enables the
# atproto loopback OAuth client (no hosted client metadata needed); anything
# else must be a public https URL, where /oauth-client-metadata.json becomes
# the OAuth client_id.
PUBLIC_URL=http://127.0.0.1:5173

# Where the SQLite database lives (OAuth sessions, webhook tokens).
DATABASE_PATH=asteroid.db

# DID PLC directory. Use http://localhost:2582 against the atproto dev network.
PLC_URL=https://plc.directory

# Only for the atproto multi-PDS dev network: its introspection endpoint,
# used to resolve *.test handles and to find the dev lexicon authority.
#DEV_INTROSPECT_URL=http://localhost:2581

# Only for `pnpm publish-lexicons` against a real PDS: the account that
# _lexicon.pebble-index.byjp.me points at, with an app password.
#LEXICON_AUTHORITY_HANDLE=
#LEXICON_AUTHORITY_PASSWORD=
#LEXICON_AUTHORITY_PDS=
